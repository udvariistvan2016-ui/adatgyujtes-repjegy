# VPS / Linux (később). Laptopon Task Scheduler van, lásd install-windows-task.ps1.
# Másold a projektet, hozd létre a .venv-et, chmod +x scripts/*.sh, majd crontab -e.
# A PATH-ot igazítsd a szerverhez. A gyűjtés ~15–40 perc (180 dátum).

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# 10:00 Europe/Budapest = 08:00 UTC télen, 08:00 CEST = 06:00 UTC nyáron.
# Itt téli idő (UTC+1) van feltételezve: 08:00 UTC.
0 8 * * * /path/to/adatgyujtes-repjegy/scripts/collect.sh >> /path/to/adatgyujtes-repjegy/data/collect.log 2>&1

# 12:00 újrapróba (csak hibás keresések) — 10:00 UTC télen
0 10 * * * /path/to/adatgyujtes-repjegy/scripts/collect.sh >> /path/to/adatgyujtes-repjegy/data/collect.log 2>&1

# SQLite backup 12:40
40 10 * * * /path/to/adatgyujtes-repjegy/scripts/backup-db.sh >> /path/to/adatgyujtes-repjegy/data/backup.log 2>&1

# 15:00 Azori BUD–PDL 7 éj (scope stay) — 14:00 UTC télen. A 10:00-es MAD ettől független.
0 14 * * * /path/to/adatgyujtes-repjegy/scripts/collect.sh --scope stay >> /path/to/adatgyujtes-repjegy/data/collect.log 2>&1

# 17:00 PDL újrapróba — 16:00 UTC télen
0 16 * * * /path/to/adatgyujtes-repjegy/scripts/collect.sh --scope stay >> /path/to/adatgyujtes-repjegy/data/collect.log 2>&1
